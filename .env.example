# 可选。生产环境建议设置至少 16 位，用于 AES-GCM 加密模型 API Key。
# 本地未设置时，应用会在 data/.model-key-secret 自动生成仅本机使用的密钥。
# MODEL_KEY_ENCRYPTION_SECRET=replace-with-a-long-random-secret

# 可选：应用公开地址，用于 Open Graph 等绝对 URL。
APP_BASE_URL=http://localhost:3050

# 可选：默认是项目根目录下的 data。
# JIANTI_DATA_DIR=D:\\teacher-question-bank-data

# 可选：服务端生成 PDF 所使用的 Chrome / Edge / Chromium 路径。
# Windows 和常见 Linux/macOS 安装位置会自动检测。
# CHROMIUM_EXECUTABLE_PATH=C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe

# 仅在受控 Linux 容器中 Chromium 无法启用沙箱时使用；普通部署不要开启。
# CHROMIUM_NO_SANDBOX=1

# 本地启动器统一管理 Next.js、NestJS 和 Worker，默认仅监听本机。
JIANTI_DEPLOYMENT_MODE=local
JIANTI_DATABASE_PROVIDER=sqlite
# JIANTI_WEB_PORT=3050
# JIANTI_API_PORT=3051
# JIANTI_API_URL=http://127.0.0.1:3051

# 可选 FastAPI 后台分页：npm run local:python（首次需 Python 3.11+ 和网络）。
# 或在一键启动时启用：
# JIANTI_WITH_PYTHON=1
# 独立部署时，API/Worker 使用同一私有处理地址和至少 32 字符服务密钥：
# JIANTI_DOCUMENT_PROCESSOR_URL=http://127.0.0.1:3052
# JIANTI_PROCESSOR_TOKEN=replace-with-a-long-random-service-secret

# 远端模式从 Bearer JWT 或 jianti-session Cookie 验证用户，忽略 owner header。
# 需外部登录服务签发 HS256 JWT，sub=租户/用户 ID，并提供 exp、iss、aud。
# JIANTI_DEPLOYMENT_MODE=remote
# JIANTI_AUTH_SECRET=replace-with-at-least-32-random-characters
# JIANTI_AUTH_ISSUER=https://your-login-service.example
# JIANTI_AUTH_AUDIENCE=jianti
# JIANTI_WEB_HOST=0.0.0.0
# API、Worker、FastAPI 应放在服务器私有网络；外部只发布 Web/反向代理。
# PostgreSQL 适配器尚未实现：不能仅设置 DATABASE_URL 切换数据库。
