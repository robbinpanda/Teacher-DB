# 可选。生产环境建议设置至少 16 位，用于 AES-GCM 加密模型 API Key。
# 本地未设置时，应用会在 data/.model-key-secret 自动生成仅本机使用的密钥。
# MODEL_KEY_ENCRYPTION_SECRET=replace-with-a-long-random-secret

# 可选：应用公开地址，用于 Open Graph 等绝对 URL。
APP_BASE_URL=http://localhost:3000

# 可选：默认是项目根目录下的 data。
# SHITI_DATA_DIR=D:\\teacher-question-bank-data
