{
  "name": "jianti-teacher-question-bank",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "node scripts/run-local.mjs --dev",
    "build": "next build",
    "start": "node scripts/run-local.mjs",
    "local": "node scripts/run-local.mjs --build",
    "local:python": "node scripts/run-local.mjs --build --with-python",
    "api": "node --import ./server/register.mjs --import tsx server/main.ts",
    "worker": "node --import ./server/register.mjs --import tsx server/worker.ts",
    "backend:verify": "node scripts/verify-backend.mjs",
    "processor:verify": "node scripts/verify-processor.mjs",
    "remote:verify": "node scripts/verify-remote.mjs",
    "local:verify": "node scripts/verify-local.mjs",
    "test:browser": "playwright test",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "restore": "node scripts/restore.mjs",
    "doctor": "node scripts/doctor.mjs",
    "queue:verify": "node scripts/verify-queue.mjs",
    "skills:verify": "node scripts/verify-teaching-skills.mjs",
    "variations:verify": "node scripts/verify-variation-workflow.mjs",
    "review:verify": "node --experimental-strip-types scripts/verify-review-fixes.mjs",
    "review:verify-startup": "node scripts/verify-review-startup.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "0.45.2",
    "katex": "^0.18.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.6",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "server-only": "^0.0.1",
    "sharp": "0.34.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/katex": "^0.16.8",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
